#!/usr/bin/env bash
set -euo pipefail
project=$(cd -- "$(dirname -- "$0")/.." && pwd)
if [[ -z "${ISLAND_TEST_SESSION:-}" ]]; then
    exec "$project/bin/test-session" -- "$project/bin/test" "$@"
fi
python3 "$project/tests/session-isolation.py"
node "$project/tests/agent-limits.test.cjs"
python3 "$project/tests/agent-limits-collector.py"
python3 "$project/tests/agent-limits-qml.py"
node "$project/tests/model.test.cjs"
node "$project/tests/reminders.test.cjs"
"$project/bin/vendor-calendars"
node "$project/tests/calendar-events.test.cjs"
python3 "$project/tests/calendar-ics.py"
python3 "$project/tests/calendar-subscriptions.py"
python3 "$project/tests/calendar-reminders.py"
node "$project/tests/design.test.cjs"
python3 "$project/tests/design-qml.py"
node "$project/tests/spotlight.test.cjs"
node "$project/tests/settings.test.cjs"
node "$project/tests/t3.test.cjs"
python3 "$project/tests/t3-bridge.py"
python3 "$project/tests/t3-qml.py"
node "$project/tests/osd.test.cjs"
node "$project/tests/dictation.test.cjs"
python3 "$project/tests/dictation-state.py"
node "$project/tests/layout.test.cjs"
node "$project/tests/panel-geometry.test.cjs"
python3 "$project/tests/downloads.py"
python3 "$project/tests/downloads-service.py"
python3 "$project/tests/weather.py"
python3 "$project/tests/weather-summary.py"
python3 "$project/tests/weather-service.py"
python3 "$project/tests/notification-service.py"
python3 "$project/tests/install.py"
python3 "$project/tests/indicators-install.py"
python3 "$project/tests/native-install.py"
python3 "$project/tests/qml-smoke.py"
python3 "$project/tests/overview.py"
python3 "$project/tests/performance.py"
python3 "$project/tests/controls-adapter.py"
python3 "$project/tests/control-keys.py"
python3 "$project/tests/controls.py"
python3 "$project/tests/update-service.py"
python3 "$project/tests/battery.py"

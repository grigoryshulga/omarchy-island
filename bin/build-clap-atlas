#!/usr/bin/env python3
"""Convert the supplied 8-frame glove GIF into a shader mask (requires Pillow).

Usage: python3 bin/build-clap-atlas "/path/to/ASCII Glove Clapping Animation.gif"
The runtime uses only the resulting PNG, with the original 120 ms frame timing.
"""
from pathlib import Path
import sys

from PIL import Image, ImageFilter, ImageOps, ImageSequence

source = Image.open(sys.argv[1])
frames = [ImageOps.grayscale(frame.convert('RGB')) for frame in ImageSequence.Iterator(source)]
if len(frames) != 8 or any(frame.size != frames[0].size for frame in frames):
    raise SystemExit('Expected eight equally sized frames')
bounds = [frame.point(lambda value: 255 if value > 32 else 0).getbbox() for frame in frames]
crop = (max(0, min(b[0] for b in bounds)-8), max(0, min(b[1] for b in bounds)-8),
        min(source.width, max(b[2] for b in bounds)+8), min(source.height, max(b[3] for b in bounds)+8))
atlas = Image.new('RGB', (256*8, 224))
for index, frame in enumerate(frames):
    # Average the ASCII scanlines before sampling the much coarser dot grid.
    # A shared crop preserves motion and the impact rays across every frame.
    mask = frame.filter(ImageFilter.GaussianBlur(1.2)).crop(crop)
    mask = ImageOps.contain(mask, (248, 216), Image.Resampling.LANCZOS)
    atlas.paste(mask, (index*256+(256-mask.width)//2, (224-mask.height)//2))
target = Path(__file__).resolve().parents[1]/'plugin/assets/clap-atlas.png'
atlas.save(target, optimize=True)
print(target)

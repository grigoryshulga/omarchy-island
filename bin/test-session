#!/usr/bin/env python3
"""Run checks in a disposable desktop session, locally or in CI."""
import argparse
import os
from pathlib import Path
import shutil
import signal
import subprocess
import tempfile

project = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--wayland', action='store_true', help='start a private headless Sway compositor')
parser.add_argument('command', nargs=argparse.REMAINDER)
args = parser.parse_args()
command = args.command
if command[:1] == ['--']:
    command = command[1:]
if not command:
    parser.error('provide a command after --')
for dependency in ['dbus-run-session'] + (['sway'] if args.wayland else []):
    if not shutil.which(dependency):
        parser.exit(2, f'Missing {dependency}; refusing to use the desktop session.\n')

with tempfile.TemporaryDirectory(prefix='island-test-session-') as temporary:
    root = Path(temporary)
    for name in ['home', 'runtime', 'tmp']:
        (root / name).mkdir(mode=0o700)
    # An allowlist avoids inheriting compositor, D-Bus, audio, credential and
    # Qt plugin/loader settings. This is session separation, not a security sandbox.
    env = dict(PATH='/usr/bin:/usr/share/omarchy/bin', HOME=str(root / 'home'),
               XDG_RUNTIME_DIR=str(root / 'runtime'), TMPDIR=str(root / 'tmp'),
               LANG='C.UTF-8', QT_QPA_PLATFORM='offscreen', QT_QUICK_BACKEND='software',
               PYTHONDONTWRITEBYTECODE='1', OMARCHY_PATH='/usr/share/omarchy',
               DBUS_SYSTEM_BUS_ADDRESS='unix:path=' + str(root / 'no-system-bus'),
               PULSE_SERVER='unix:' + str(root / 'no-pulse'),
               ISLAND_TEST_SESSION=str(root), LIBGL_ALWAYS_SOFTWARE='1')
    for name in ['ISLAND_TEST_GPU', 'ISLAND_T3_ONLY']:
        if name in os.environ:
            env[name] = os.environ[name]
    argv = ['dbus-run-session', '--', '/usr/bin/python3', str(project / 'tests/test_session.py')]
    if args.wayland:
        argv += ['--wayland']
    argv += ['--', *command]
    process = subprocess.Popen(argv, env=env, start_new_session=True)
    def interrupted(signum, frame):
        raise SystemExit(128 + signum)
    signal.signal(signal.SIGTERM, interrupted)
    try:
        result = process.wait()
    finally:
        # Also stop descendants left behind by a failed test before removing files.
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait()
    raise SystemExit(result)

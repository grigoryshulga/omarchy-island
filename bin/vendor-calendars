#!/usr/bin/env python3
"""Verify bundled pure-Python wheels, or restore the exact locked PyPI files."""
import argparse
import hashlib
import json
from pathlib import Path
import urllib.request
import zipfile

root = Path(__file__).resolve().parents[1] / 'plugin/vendor/calendar'
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--restore', action='store_true', help='download missing or modified locked wheels')
args = parser.parse_args()
for entry in json.loads((root / 'lock.json').read_text()):
    path = root / entry['file']
    if args.restore and (not path.exists() or hashlib.sha256(path.read_bytes()).hexdigest() != entry['sha256']):
        with urllib.request.urlopen(entry['url'], timeout=20) as response:
            raw = response.read(4 * 1024 * 1024)
        assert hashlib.sha256(raw).hexdigest() == entry['sha256'], entry['file']
        path.write_bytes(raw)
    assert hashlib.sha256(path.read_bytes()).hexdigest() == entry['sha256'], entry['file']
    with zipfile.ZipFile(path) as wheel:
        assert not any(name.endswith(('.so', '.dll', '.pyc')) for name in wheel.namelist()), path
        for name in wheel.namelist():
            if '.dist-info/' in name and ('license' in name.lower() or 'copying' in name.lower()) and not name.endswith('/'):
                target = root / 'licenses' / entry['name'] / name.split('.dist-info/', 1)[1]
                if args.restore:
                    target.parent.mkdir(parents=True, exist_ok=True)
                    target.write_bytes(wheel.read(name))
                assert target.read_bytes() == wheel.read(name), target
gpl = root / 'licenses/GPL-3.0.txt'
gpl_hash = '3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986'
if args.restore and not gpl.exists():
    with urllib.request.urlopen('https://www.gnu.org/licenses/gpl-3.0.txt', timeout=20) as response:
        raw = response.read(65536)
    assert hashlib.sha256(raw).hexdigest() == gpl_hash
    gpl.write_bytes(raw)
assert hashlib.sha256(gpl.read_bytes()).hexdigest() == gpl_hash
print('PASS: pinned calendar libraries and licenses.')

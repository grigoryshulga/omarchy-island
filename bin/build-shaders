#!/usr/bin/env bash
set -euo pipefail
project=$(cd -- "$(dirname -- "$0")/.." && pwd)
python3 - "$project" <<'PY'
import pathlib,re,subprocess,sys
root=pathlib.Path(sys.argv[1])/'plugin/shaders'
for fragment in sorted(root.glob('*.frag')):
    block=re.search(r'layout\(std140[^;]*?uniform\s+buf\s*\{.*?\};',fragment.read_text(),re.S)
    if not block: raise SystemExit(f'Missing uniform block: {fragment}')
    vertex=fragment.with_suffix('.vert')
    vertex.write_text('''#version 440
// Generated by bin/build-shaders to keep both stages on the same profile.
layout(location = 0) in vec4 qt_Vertex;
layout(location = 1) in vec2 qt_MultiTexCoord0;
layout(location = 0) out vec2 qt_TexCoord0;
'''+block[0]+'''
void main() {
  qt_TexCoord0 = qt_MultiTexCoord0;
  gl_Position = qt_Matrix * qt_Vertex;
}
''')
    for source in (vertex,fragment):
        subprocess.run(['/usr/lib/qt6/bin/qsb','--glsl','300 es,150','--hlsl','50','--msl','12','-o',str(source)+'.qsb',str(source)],check=True)
PY

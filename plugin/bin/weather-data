#!/usr/bin/env python3
"""Omarchy weather location + bounded HTTPS requests to the stock providers."""
import json
import math
import pathlib
import re
import sys
import time
import urllib.parse
import urllib.request

MAX_BYTES = 2 * 1024 * 1024

def fetch(url):
    parsed = urllib.parse.urlsplit(url)
    if parsed.scheme != 'https' or parsed.hostname not in {'geo.omarchy.org', 'api.open-meteo.com', 'geocoding-api.open-meteo.com'}:
        raise ValueError('Unknown weather provider')
    request = urllib.request.Request(url, headers={'User-Agent': 'Omarchy-Island/0.2'})
    with urllib.request.urlopen(request, timeout=6) as response:
        final = urllib.parse.urlsplit(response.url)
        if final.scheme != 'https' or final.hostname not in {'geo.omarchy.org', 'api.open-meteo.com', 'geocoding-api.open-meteo.com'}:
            raise ValueError('Unexpected weather redirect')
        raw = response.read(MAX_BYTES + 1)
        if len(raw) > MAX_BYTES:
            raise ValueError('Weather response too large')
    return json.loads(raw)

def point(value):
    try:
        lat, lon = float(value.get('latitude')), float(value.get('longitude'))
        if math.isfinite(lat) and math.isfinite(lon) and -90 <= lat <= 90 and -180 <= lon <= 180:
            return {'latitude': lat, 'longitude': lon}
    except (ValueError, TypeError, AttributeError):
        pass
    return None

def search(query, language='en'):
    query = query.strip()[:128]
    if len(query) < 2:
        return []
    language = language if re.fullmatch('[a-z]{2}', language) else 'en'
    data = fetch('https://geocoding-api.open-meteo.com/v1/search?' + urllib.parse.urlencode({'name': query, 'count': 5, 'language': language, 'format': 'json'}))
    out = []
    for row in data.get('results', [])[:5]:
        coords = point(row)
        if coords and isinstance(row.get('name'), str):
            out.append(dict(coords, name=row['name'][:128], country=str(row.get('country', ''))[:128], description=', '.join(str(row.get(key, '')) for key in ['admin1', 'country'] if row.get(key))[:256]))
    return out

def forecast():
    path = pathlib.Path.home() / '.local/state/omarchy/settings/weather.json'
    configured = {}
    if path.is_file():
        with path.open('rb') as stream:
            raw = stream.read(32769)
        if len(raw) > 32768:
            raise ValueError('Location file too large')
        try:
            configured = json.loads(raw)
            if not isinstance(configured, dict):
                configured = {}
        except ValueError:
            configured = {}
    name = str(configured.get('name') or '').strip()[:128]
    place = configured if point(configured) else None
    if place is None and name:
        matches = search(name)
        if not matches:
            raise ValueError('City not found')
        place = matches[0]
    if place is None:
        place = fetch('https://geo.omarchy.org/')
    coords = point(place)
    if not coords:
        raise ValueError('Weather location unavailable')
    location = dict(coords, name=str(place.get('name', name))[:128], country=str(place.get('country', ''))[:128])
    args = dict(coords, current='temperature_2m,apparent_temperature,relative_humidity_2m,wind_speed_10m,weather_code,is_day', daily='weather_code,temperature_2m_max,temperature_2m_min,sunrise,sunset', forecast_days=8, timezone='auto')
    data = fetch('https://api.open-meteo.com/v1/forecast?' + urllib.parse.urlencode(args))
    return {'location': location, 'forecast': data, 'fetchedAt': int(time.time())}

if __name__ == '__main__':
    try:
        if len(sys.argv) > 1 and sys.argv[1] == 'search':
            query = sys.argv[2] if len(sys.argv) > 2 else ''
            result = {'query': query, 'results': search(query, sys.argv[3] if len(sys.argv) > 3 else 'en')}
        else:
            result = forecast()
        print(json.dumps(result, ensure_ascii=False))
    except Exception:
        print('Weather request failed.', file=sys.stderr)
        sys.exit(1)

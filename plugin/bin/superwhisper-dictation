#!/usr/bin/env python3
"""Read Superwhisper's indicator without activating it or reading dictation history."""
import json
import math

try:
    from gi.repository import Gio, GLib
except ImportError:
    raise SystemExit(1)

INDICATOR = "com.superwhisper.Indicator"
PROCESSING = {"stopping", "transcribing", "vocabulary", "cleaning", "delivering"}


def main():
    proxy = Gio.DBusProxy.new_for_bus_sync(
        Gio.BusType.SESSION, Gio.DBusProxyFlags.DO_NOT_AUTO_START, None,
        INDICATOR, "/com/superwhisper/Indicator", INDICATOR, None,
    )
    previous = None

    def read(key):
        value = proxy.get_cached_property(key)
        return value.unpack() if value is not None else None

    def publish(*_):
        nonlocal previous
        phase = read("Phase") if proxy.get_name_owner() else None
        mode = "idle"
        peak = None
        if phase == "recording":
            mode = phase
            level = read("Level")
            if isinstance(level, (float, int)) and math.isfinite(level) and level >= 0:
                peak = min(1, level)
            else:
                wave = read("Waveform")
                if isinstance(wave, list) and len(wave) == 6 and all(
                    isinstance(value, (float, int)) and math.isfinite(value) for value in wave
                ):
                    peak = sum(max(0, min(1, (value - 2) / 16)) for value in wave) / len(wave)
        elif isinstance(phase, str) and phase in PROCESSING:
            mode = "transcribing"
        # With its native indicator hidden, Superwhisper reports recording but
        # leaves Level and Waveform at zero. Island can meter its routed input.
        input_meter = mode == "recording" and read("Visible") is False
        snapshot = (mode, peak, input_meter)
        if snapshot != previous:
            print(json.dumps({"mode": mode, "peak": peak, "inputMeter": input_meter}), flush=True)
            previous = snapshot

    proxy.connect("g-properties-changed", publish)
    proxy.connect("notify::g-name-owner", publish)
    publish()
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""Follow Hex's dictation state without starting the app or exposing its status payload."""

import json
import subprocess
import time


def read_mode():
    try:
        reply = subprocess.run(
            ["hex", "status", "--json"], stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL, timeout=0.5,
        )
        if reply.returncode == 3:
            return "idle", 1.5
        if reply.returncode:
            return None, 1.0
        report = json.loads(reply.stdout)
        mode = report["capture"]["state"]
    except FileNotFoundError:
        return "idle", 3.0
    except (OSError, subprocess.TimeoutExpired, ValueError, TypeError, KeyError):
        return None, 0.5
    if mode in ("recording", "transcribing", "idle"):
        return mode, 0.25 if mode == "idle" else 0.14
    return None, 0.5


def main():
    previous = None
    failures = 0
    while True:
        mode, interval = read_mode()
        failures = failures + 1 if mode is None else 0
        if failures >= 2:
            mode = "idle"
        if mode is not None and mode != previous:
            print(mode, flush=True)
            previous = mode
        time.sleep(interval)


if __name__ == "__main__":
    main()
